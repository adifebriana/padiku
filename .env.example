# Isi alamat PostgreSQL dan password database.
DATABASE_URL=postgresql://postgres@localhost:5432/padiku
DATABASE_PASSWORD=password

# Koneksi server controller ke EMQX. Gunakan mqtts://host:8883 untuk TLS.
MQTT_URL=
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=padiku-controller

# Contoh nama topik awal; sesuaikan dengan firmware ESP8266.
MQTT_TOPIC_TELEMETRY=padiku/dryer/telemetry
MQTT_TOPIC_COMMANDS=padiku/dryer/commands
MQTT_TOPIC_ACKS=padiku/dryer/acks

# Gunakan true jika aplikasi memakai HTTPS.
PADIKU_COOKIE_SECURE=false

PORT=3000
